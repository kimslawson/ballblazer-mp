# Build artifacts
/build/
*.o
*.bin
*.xex
*.map
*.rebuilt
*.raw

# --- ROMs: NEVER commit copyrighted cartridge images or their disassembly ---
# The Ballblazer ROM is copyrighted (Lucasfilm Games / Atari).  Supply your own
# legally-owned dump locally; it stays out of version control.
/rom/*
!/rom/README.md
!/rom/.gitkeep

# Disk images and extracted sector/segment data are copyrighted too.
*.atr
*.img
/build/disk/

# A full verbatim disassembly of the ROM/disk is a derivative work of
# copyrighted code - keep it local too.  Your annotated info files
# (disasm/*.info) and patches ARE tracked; the generated listings are not.
/disasm/ballblazer.s
/build/ballblazer.s
*.s.local

# editor / OS cruft
*~
.DS_Store
