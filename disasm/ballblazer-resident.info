# ============================================================================
# ballblazer-resident.info  -  da65 label map for the running game image
# ----------------------------------------------------------------------------
# The tracked map of what is known about the supported disk image. It holds
# ONLY addresses and labels (memory-map facts) - no game code. Run it against
# your own local RAM capture for an annotated listing:
#
#     make dump-run                               # -> build/disk/ram_run.bin
#     da65 -i disasm/ballblazer-resident.info     # -> build/disk/resident.s
#
# (both outputs are git-ignored). Details and evidence: docs/04-findings.md.
# The same addresses, as assembler equates: src/netplay/game.inc.
#
# da65 comment char is '#'.  ';' inside { } is a separator, not a comment.
# ============================================================================

GLOBAL {
    INPUTNAME  "build/disk/ram_run.bin";
    OUTPUTNAME "build/disk/resident.s";
    STARTADDR  $0000;
    CPU        "6502";
    COMMENTS   3;
};

# Not code: zero page, stack, OS pages, sprite memory, display list, and the
# 48 pages of prerendered line patterns.
RANGE { START $0000; END $3FFF; TYPE ByteTable; };

# ==== start-up and scheduling ============================================
LABEL { NAME "cold_start";   ADDR $4C00; COMMENT "SEI, clear ZP and $0300-$3FFF, build tables, install VBI"; };
LABEL { NAME "main_loop";    ADDR $4C72; COMMENT "redraws one view per pass; all simulation is in the tick"; };
LABEL { NAME "main_loop_jmp";ADDR $4C8A; COMMENT "JMP main_loop (netplay: -> idle, to enable IRQs)"; };
LABEL { NAME "vbi_first";    ADDR $4C8D; COMMENT "first VBI: enables DLIs, seeds $B5/$B6 from RANDOM"; };
LABEL { NAME "vbi";          ADDR $4CAB; COMMENT "immediate VBI: runs the tick unless $B4 says no"; };
LABEL { NAME "tick";         ADDR $4CBE; COMMENT "THE SIMULATION, once per frame (netplay: -> hook)"; };
LABEL { NAME "tick_end";     ADDR $4E15; COMMENT "INC $B4 / RTS"; };
LABEL { NAME "clear_ram";    ADDR $5FA4; COMMENT "zeroes $00-$FF and $0300-$3FFF"; };
LABEL { NAME "draw_view1";   ADDR $9C28; COMMENT "main loop: redraw player 1's view"; };
LABEL { NAME "draw_view2";   ADDR $A08F; COMMENT "main loop: redraw player 2's view"; };
LABEL { NAME "bad_catchup";  ADDR $A439; COMMENT "JSR $4C41 - damaged; the other three say JSR tick"; };

LABEL { NAME "render_due";   ADDR $00B3; COMMENT "set by a display kernel: main loop may redraw"; };
LABEL { NAME "tick_guard";   ADDR $00B4; COMMENT "0 idle, $FF tick running, 1 main loop copying"; };
LABEL { NAME "view_turn";    ADDR $00B5; COMMENT "which view the main loop draws next"; };
LABEL { NAME "tick_count";   ADDR $00B6; COMMENT "parity decides which craft is processed first"; };

# ==== input (all inside the tick) ========================================
LABEL { NAME "poll_keys";    ADDR $5DA5; COMMENT "console keys + keyboard -> $C1"; };
LABEL { NAME "rd_irqst";     ADDR $5DAB; COMMENT "BIT IRQST: key/break pending? (IRQs are never taken)"; };
LABEL { NAME "wr_irqen_a";   ADDR $5DAE; COMMENT "STA IRQEN (acknowledge)"; };
LABEL { NAME "rd_kbcode";    ADDR $5DB7; COMMENT "LDA KBCODE"; };
LABEL { NAME "rd_consol";    ADDR $5DBD; COMMENT "LDA CONSOL; START/SELECT/OPTION -> key codes $27/$6C/$2C"; };
LABEL { NAME "wr_irqen_b";   ADDR $5DE4; COMMENT "STA IRQEN (re-arm)"; };
LABEL { NAME "player_ctrl";  ADDR $5F27; COMMENT "per player: joystick, or the droid if designated"; };
LABEL { NAME "rd_joy_p1";    ADDR $5F3D; COMMENT "LDA PORTA (low nibble)"; };
LABEL { NAME "rd_trig_p1";   ADDR $5F46; COMMENT "LDX TRIG0"; };
LABEL { NAME "rd_joy_p2";    ADDR $5F7A; COMMENT "LDA PORTA (high nibble)"; };
LABEL { NAME "rd_trig_p2";   ADDR $5F85; COMMENT "LDX TRIG1"; };
LABEL { NAME "droid";        ADDR $9A4A; COMMENT "droid move generator (uses RANDOM)"; };
LABEL { NAME "p1_designation"; ADDR $23DE; COMMENT "0 = HUMAN, else DROID level"; };
LABEL { NAME "p2_designation"; ADDR $33DE; COMMENT "0 = HUMAN, else DROID level"; };

# ==== facing (simulation state the stock game latches from a DLI) ========
LABEL { NAME "p1_face";      ADDR $000C; COMMENT "player 1 facing, 0-3, as the simulation steers by"; };
LABEL { NAME "p1_face_req";  ADDR $0011; COMMENT "player 1 facing requested by the simulation"; };
LABEL { NAME "p2_face";      ADDR $0020; };
LABEL { NAME "p2_face_req";  ADDR $0025; };
LABEL { NAME "face_changed"; ADDR $00B7; COMMENT "DEC'd when a facing is latched"; };
LABEL { NAME "p1_face_latch";ADDR $5A13; COMMENT "in DLI: request -> current when the view's frame flipped"; };
LABEL { NAME "p2_face_latch";ADDR $5C76; };

# ==== display interrupts =================================================
LABEL { NAME "dli_p1_setup"; ADDR $599B; COMMENT "player/missile registers for view 1"; };
LABEL { NAME "dli_p1_kernel";ADDR $5A39; COMMENT "51 scanlines of per-line scroll/colour writes"; };
LABEL { NAME "dli_p1_work";  ADDR $5BF5; COMMENT "JSR view1_tables, still inside the interrupt"; };
LABEL { NAME "dli_p2_setup"; ADDR $5BFE; };
LABEL { NAME "dli_p2_kernel";ADDR $5C9C; };
LABEL { NAME "dli_p2_work";  ADDR $5D9C; COMMENT "JSR view2_tables"; };
LABEL { NAME "view1_tables"; ADDR $7F56; COMMENT "long; also called at start-up"; };
LABEL { NAME "view2_tables"; ADDR $80CC; };

# ==== sound ==============================================================
LABEL { NAME "snd_commit";   ADDR $797B; COMMENT "writes AUDF1..AUDC4 from $F9,$FA,$F6,$F7,$F3,$F4,$F0,$F1"; };
LABEL { NAME "snd_init";     ADDR $79D4; COMMENT "includes STY AUDCTL at $79E0"; };

# ==== dead code ==========================================================
LABEL { NAME "old_loader";   ADDR $BC00; COMMENT "original loader, $BC00-$BFFF; unreferenced by the game"; };

# ==== hardware / OS ======================================================
LABEL { NAME "TRIG0";  ADDR $D010; };
LABEL { NAME "TRIG1";  ADDR $D011; };
LABEL { NAME "CONSOL"; ADDR $D01F; };
LABEL { NAME "KBCODE"; ADDR $D209; };
LABEL { NAME "RANDOM"; ADDR $D20A; };
LABEL { NAME "IRQEN";  ADDR $D20E; };
LABEL { NAME "SKCTL";  ADDR $D20F; };
LABEL { NAME "PORTA";  ADDR $D300; };
LABEL { NAME "WSYNC";  ADDR $D40A; };
LABEL { NAME "NMIEN";  ADDR $D40E; };
LABEL { NAME "VDSLST"; ADDR $0200; };
LABEL { NAME "VVBLKI"; ADDR $0222; };
LABEL { NAME "XITVBV"; ADDR $E462; };
