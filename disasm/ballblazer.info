# ============================================================================
# ballblazer.info  -  da65 control file for the CARTRIDGE variant of Ballblazer
# ----------------------------------------------------------------------------
# NOTE: the disk (.atr) variant uses disasm/disk-boot.info instead; disasm.sh
# auto-selects.  Use this file only for a 16K cart dump.
#
# THIS FILE CONTAINS NO ROM CONTENT.  It is a reverse-engineering control file:
# the standard Atari cartridge structure, well-known OS/hardware equates, and a
# place to record game-specific labels AS YOU DISCOVER THEM.
#
# da65 comment char is '#'.  ';' inside { } is a separator, not a comment.
# Workflow: see docs/03-disassembly.md.  Carve data ranges iteratively until
# disasm/rebuild.sh reports the rebuilt image is byte-identical.
# ============================================================================

GLOBAL {
    INPUTNAME  "build/ballblazer.raw";
    OUTPUTNAME "build/ballblazer.s";
    STARTADDR  $8000;              # 16K cart -> $8000-$BFFF (8K dump: $A000)
    CPU        "6502";
    COMMENTS   3;
};

# ---- Cartridge control block ($BFFA-$BFFF) -----------------------------
RANGE { START $BFFA; END $BFFB; TYPE AddrTable; };   # run/start vector
RANGE { START $BFFC; END $BFFD; TYPE ByteTable; };   # present flag, options
RANGE { START $BFFE; END $BFFF; TYPE AddrTable; };   # init vector

LABEL { NAME "cart_run";     ADDR $BFFA; COMMENT "OS JMPs here to run cart"; };
LABEL { NAME "cart_present"; ADDR $BFFC; COMMENT "$00 = cartridge present"; };
LABEL { NAME "cart_opts";    ADDR $BFFD; COMMENT "bit2=init cart, bit0=boot disk"; };
LABEL { NAME "cart_init";    ADDR $BFFE; COMMENT "OS JSRs here to init cart"; };

# ---- Zero page / page 2 OS variables the game surely touches -----------
LABEL { NAME "RTCLOK";  ADDR $0012; COMMENT "3-byte frame clock"; };
LABEL { NAME "SDMCTL";  ADDR $022F; COMMENT "DMA control shadow"; };
LABEL { NAME "SDLSTL";  ADDR $0230; COMMENT "display list ptr lo"; };
LABEL { NAME "SDLSTH";  ADDR $0231; COMMENT "display list ptr hi"; };
LABEL { NAME "STICK0";  ADDR $0278; COMMENT "joystick 0 shadow"; };
LABEL { NAME "STICK1";  ADDR $0279; COMMENT "joystick 1 shadow"; };
LABEL { NAME "STRIG0";  ADDR $0284; COMMENT "trigger 0 shadow"; };
LABEL { NAME "STRIG1";  ADDR $0285; COMMENT "trigger 1 shadow"; };
LABEL { NAME "COLOR0";  ADDR $02C4; };
LABEL { NAME "COLOR1";  ADDR $02C5; };
LABEL { NAME "COLOR2";  ADDR $02C6; };
LABEL { NAME "COLOR3";  ADDR $02C7; };
LABEL { NAME "COLOR4";  ADDR $02C8; };
LABEL { NAME "DVSTAT";  ADDR $02EA; COMMENT "4-byte device status (N: bytes-waiting)"; };
LABEL { NAME "CIOV";    ADDR $E456; COMMENT "CIO entry, X = IOCB#*16"; };
LABEL { NAME "SIOV";    ADDR $E459; COMMENT "SIO entry"; };
LABEL { NAME "SETVBV";  ADDR $E45C; COMMENT "set vertical-blank vector"; };
LABEL { NAME "XITVBV";  ADDR $E462; COMMENT "exit vertical blank"; };

# ---- GTIA ($D000-$D01F) ------------------------------------------------
LABEL { NAME "HPOSP0"; ADDR $D000; };
LABEL { NAME "HPOSP1"; ADDR $D001; };
LABEL { NAME "HPOSP2"; ADDR $D002; };
LABEL { NAME "HPOSP3"; ADDR $D003; };
LABEL { NAME "GRAFP0"; ADDR $D00D; };
LABEL { NAME "TRIG0";  ADDR $D010; };
LABEL { NAME "COLPM0"; ADDR $D012; };
LABEL { NAME "PAL";    ADDR $D014; };
LABEL { NAME "COLBK";  ADDR $D01A; };
LABEL { NAME "PRIOR";  ADDR $D01B; };
LABEL { NAME "CONSOL"; ADDR $D01F; COMMENT "Start/Select/Option (active low)"; };

# ---- POKEY ($D200-$D20F) -----------------------------------------------
LABEL { NAME "AUDF1";  ADDR $D200; };
LABEL { NAME "AUDC1";  ADDR $D201; };
LABEL { NAME "AUDF2";  ADDR $D202; };
LABEL { NAME "AUDC2";  ADDR $D203; };
LABEL { NAME "AUDCTL"; ADDR $D208; };
LABEL { NAME "RANDOM"; ADDR $D20A; COMMENT "PRNG - watch the droid AI read this"; };
LABEL { NAME "SKCTL";  ADDR $D20F; };

# ---- PIA ($D300-$D303): joystick directions live here ------------------
LABEL { NAME "PORTA";  ADDR $D300; COMMENT "joysticks 0/1 directions"; };
LABEL { NAME "PORTB";  ADDR $D301; };
LABEL { NAME "PACTL";  ADDR $D302; };
LABEL { NAME "PBCTL";  ADDR $D303; };

# ---- ANTIC ($D400-$D40F) -----------------------------------------------
LABEL { NAME "DMACTL"; ADDR $D400; };
LABEL { NAME "DLISTL"; ADDR $D402; };
LABEL { NAME "DLISTH"; ADDR $D403; };
LABEL { NAME "HSCROL"; ADDR $D404; COMMENT "fine scroll - the Rotoscape grid"; };
LABEL { NAME "VSCROL"; ADDR $D405; };
LABEL { NAME "WSYNC";  ADDR $D40A; };
LABEL { NAME "VCOUNT"; ADDR $D40B; };
LABEL { NAME "NMIEN";  ADDR $D40E; };

